[Desktop Entry]
Type=Application
Name=Vidnux
GenericName=Video Converter
Comment=Convert video to editor-ready formats without losing quality
Exec=vidnux %F
Icon=vidnux
Terminal=false
StartupWMClass=vidnux
StartupNotify=true
Categories=AudioVideo;Video;AudioVideoEditing;
MimeType=video/mp4;video/x-matroska;video/quicktime;video/x-msvideo;video/mpeg;video/x-ms-wmv;video/webm;video/mp2t;
Keywords=video;convert;transcode;ffmpeg;davinci;resolve;proxy;
